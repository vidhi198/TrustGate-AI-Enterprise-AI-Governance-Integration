APP_NAME=TrustGate AI
APP_ENV=demo
DATABASE_PATH=trustgate.db

# mock (default, no external calls) or openai_compatible
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15

MAX_INPUT_CHARS=4000

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

DAILY_BUDGET_USD=5.00
ESTIMATED_INPUT_COST_PER_1K=0.001
ESTIMATED_OUTPUT_COST_PER_1K=0.002

# Optional: override demo keys. Format: {"role":"key"}
# TG_API_KEYS={"employee":"local-employee-key","support":"local-support-key","admin":"local-admin-key"}

# GUI -> API location
API_BASE_URL=http://localhost:8000
